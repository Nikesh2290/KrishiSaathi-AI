        "body": {
          "mode": "raw",
          "raw": "{\n  \"farmer_id\": \"demo-farmer-1\",\n  \"query\": { \"text\": \"PM-KISAN के लिए पात्रता क्या है?\", \"language\": \"hi\" },\n  \"context\": { \"location\": { \"lat\": 30.65, \"lng\": 75.95, \"district\": \"Ludhiana\" }, \"connectivity\": \"online\", \"device_intent\": \"scheme_query\" }\n}"
        },
        "url": "{{baseUrl}}/api/v1/query"
      }
    },
    {
      "name": "Query stream (SSE)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/query/stream?farmer_id=demo-farmer-1&q=weather&connectivity=online&lat=30.65&lng=75.95&device_intent=weather"
      }
    },
    {
      "name": "Get farmer twin",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/farmer/demo-farmer-1/twin"
