{
  "info": {
    "name": "KrishiSaathi API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Create conversation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"farmer_id\": \"demo-farmer-1\",\n  \"title\": \"PM-KISAN help\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/conversation?connectivity=online"
      }
    },
    {
      "name": "List conversations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/farmer/demo-farmer-1/conversations?connectivity=online"
      }
    },
    {
      "name": "Conversation history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/farmer/demo-farmer-1/conversations/REPLACE_WITH_CONVERSATION_ID/history?connectivity=online"
      }
    },
    {
      "name": "Delete conversation",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/farmer/demo-farmer-1/conversations/REPLACE_WITH_CONVERSATION_ID?connectivity=online"
      }
    },
    {
      "name": "Query stream (SSE)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "text/event-stream" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"farmer_id\": \"demo-farmer-1\",\n  \"conversation_id\": \"REPLACE_WITH_CREATE_CONVERSATION_RESPONSE\",\n  \"query\": { \"text\": \"PM-KISAN के लिए पात्रता क्या है?\", \"language\": \"hi\" },\n  \"context\": { \"location\": { \"lat\": 30.65, \"lng\": 75.95, \"district\": \"Ludhiana\" }, \"connectivity\": \"online\", \"device_intent\": \"scheme_query\" }\n}"
        },
        "url": "{{baseUrl}}/api/v1/query/stream"
      }
    },
    {
      "name": "Get farmer twin",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/farmer/demo-farmer-1/twin"
      }
    },
    {
      "name": "Put farmer twin",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"farmer_id\": \"demo-farmer-1\",\n  \"name\": \"Ramesh Kumar\",\n  \"location\": { \"state\": \"Punjab\", \"district\": \"Ludhiana\", \"village\": \"Raikot\", \"lat\": 30.65, \"lng\": 75.95 },\n  \"land\": { \"total_acres\": 4.5, \"soil_type\": \"loamy\" },\n  \"current_crops\": [\"wheat\", \"mustard\"],\n  \"preferred_language\": \"hi\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/farmer/demo-farmer-1/twin"
      }
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8000" }]
}
