# Google AI Studio (Gemini API key) — optional if Ollama covers all calls
GOOGLE_AI_STUDIO_KEY=

# Model id on Gemini API (use a Gemma / Gemma-class model available in your account)
AI_STUDIO_MODEL=gemma-3-27b-it

# Ollama — local Gemma / Gemma2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b

# auto | local | cloud
CONNECTIVITY_MODE=auto

# SQLite + Chroma paths (relative to project root)
DATABASE_PATH=./data/krishisaathi.db
CHROMA_PATH=./data/chroma

# Comma-separated origins for browser frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_REACT_ITERATIONS=6
TOOL_TIMEOUT_SECONDS=8
RATE_LIMIT_PER_MINUTE=10
