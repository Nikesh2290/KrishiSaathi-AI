# Google AI Studio (Gemini API) — required for online planner/synthesis
GOOGLE_AI_STUDIO_KEY=

# Gemma 4 models on AI Studio free tier
AI_STUDIO_MODEL=gemma-4-26b-a4b-it
AI_STUDIO_MODEL_HEAVY=gemma-4-31b-it

# Ollama — optional dev convenience; production on-device is MediaPipe on the RN app
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma-4-e4b-it

# auto | local | cloud
CONNECTIVITY_MODE=auto

# Supabase (online: Auth + Postgres + pgvector). Apply db/migrations/supabase_schema.sql in SQL Editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — required for syncing farmer_twin, conversation_metadata, query_history, scheme_vectors from this API.
SUPABASE_SERVICE_ROLE_KEY=

# Storage
DATABASE_PATH=./data/krishisaathi.db
CHROMA_PATH=./data/chroma

# CORS — harmless for RN but kept for browser dev tools
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Agent limits
MAX_REACT_ITERATIONS=6
# Fallback only for unknown tools; known tools use the timeouts below.
TOOL_TIMEOUT_SECONDS=15
VISION_TIMEOUT_SECONDS=60
LLM_TOOL_TIMEOUT_SECONDS=30
CLIMATE_TIMEOUT_SECONDS=12
IO_TOOL_TIMEOUT_SECONDS=5

# data.gov.in OGD API — mandi price sync + tool fallback
OGD_API_KEY=
MANDI_PRICE_TTL_SECONDS=86400
MARKET_TOOL_TIMEOUT_SECONDS=60

# Sync + image + confidence
SYNC_BUNDLE_CACHE_TTL_SECONDS=3600
IMAGE_UPLOAD_TTL_SECONDS=3600
IMAGE_MAX_MB=5
CONFIDENCE_THRESHOLD_LOW=0.70

# Logging
LOG_LEVEL=INFO
# true => JSON logs (recommended for production)
LOG_JSON=true
# Optional: write logs to file (in addition to console). Docker/HF image defaults this.
LOG_FILE=./logs/app.log

# LiveKit — voice room (wss URL from LiveKit Cloud). Used by POST /api/v1/voice/token + voice worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_TOKEN_TTL_SECONDS=3600

# Voice worker: Krishi HTTP API (Docker Compose: http://api:7860; Railway: https://<space>.hf.space)
KRISHI_API_BASE_URL=http://127.0.0.1:8000

# Railway voice worker only — set in Railway Variables (see railway.toml); not needed on HF Space.
# LIVEKIT_* and DEEPGRAM_API_KEY must match between HF (token API) and Railway (worker).

# Deepgram STT + TTS for the voice worker (DEEPGRAM_API_KEY required when running voice worker)
DEEPGRAM_API_KEY=
# Optional: Deepgram Aura TTS model id (see https://developers.deepgram.com/docs/tts-models )
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# Optional dev fallback if a join token has no participant metadata
VOICE_DEFAULT_FARMER_ID=
